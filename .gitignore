# Per-developer Claude Code tool permissions. Only the .local variant, so a
# shared .claude/settings.json remains possible.
.claude/settings.local.json

# macOS Finder view state (icon positions, window size). Finder writes it into
# any directory a Mac user merely browses, so it arrives without anyone
# choosing to add it -- datasets/.DS_Store reached main exactly that way. It is
# binary, machine-specific, and rewritten on every window resize, so tracking
# it means a file that is permanently dirty in git status. Unanchored, so it
# matches at any depth rather than the repo root alone.
.DS_Store
